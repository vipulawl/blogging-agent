# ── Provider ──────────────────────────────────────────────────────────────────
# Options: groq | ollama | anthropic
PROVIDER=groq

# Groq (free tier — get key at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local — install from ollama.ai, then: ollama pull llama3.1:70b)
# PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1:70b

# Anthropic (original — only needed if PROVIDER=anthropic)
# PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI — used for Strategy + Research agents (reliable tool calling).
# Writer/Editor still use Groq (free tier).
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
STRATEGY_PROVIDER=openai
# STRATEGY_MODEL=gpt-4o
RESEARCH_PROVIDER=openai
RESEARCH_MODEL=gpt-4o-mini

# ── Blog identity ─────────────────────────────────────────────────────────────
BLOG_NICHE=SaaS marketing
TARGET_AUDIENCE=early-stage startup founders
BLOG_TONE=informative and practical
BLOG_LANGUAGE=English

# ── Google APIs (optional — omit to use DuckDuckGo-only research) ─────────────
GOOGLE_CREDENTIALS_FILE=google-credentials.json
GSC_SITE_URL=https://yoursite.com/
GA4_PROPERTY_ID=123456789

# ── Publishing ────────────────────────────────────────────────────────────────
# pr  → create a GitHub PR (merge = publish, Vercel auto-deploys)
# cli → terminal review prompt (use when running manually without git)
APPROVAL_MODE=pr

# Path inside your repo where markdown articles go
# Next.js:  posts/
# Astro:    src/content/blog/
# Hugo:     content/posts/
CONTENT_DIR=posts/

# Absolute path to your site's git repo (leave blank = current directory)
# REPO_DIR=/Users/you/my-vercel-site

# ── Daemon behaviour ──────────────────────────────────────────────────────────
POLL_INTERVAL_MINUTES=60
MIN_QUEUE_SIZE=3
MAX_ARTICLES_PER_DAY=1

# ── Smart systems ─────────────────────────────────────────────────────────────
# Jaccard similarity threshold for duplicate detection (0.0–1.0)
DEDUP_THRESHOLD=0.80
# Days before a post is eligible for performance monitoring flags
PERFORMANCE_CHECK_DAYS=30
# Set to true in CI to auto-execute corrections without terminal prompts
CORRECTION_AUTO_MODE=false
# Scheduler slows down when this many posts are under 30 days old
MAX_POSTS_IN_RAMP=3
